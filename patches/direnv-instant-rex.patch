+/// Rex sets REX_BIN_DIR in its terminals; the CLI isn't always on PATH.
+fn rex_bin() -> String {
+    env::var("REX_BIN_DIR")
+        .ok()
+        .map(|dir| std::path::Path::new(&dir).join("rex"))
+        .filter(|path| path.is_file())
+        .map(|path| path.to_string_lossy().into_owned())
+        .unwrap_or_else(|| "rex".to_string())
+}
